{
  "name": "react-kb-webui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "mkdir -p .tmp && TMPDIR=$(pwd)/.tmp vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "mkdir -p .tmp && TMPDIR=$(pwd)/.tmp PLAYWRIGHT_BROWSERS_PATH=$(pwd)/.playwright-browsers playwright test",
    "install:browsers": "mkdir -p .tmp .playwright-browsers && TMPDIR=$(pwd)/.tmp PLAYWRIGHT_BROWSERS_PATH=$(pwd)/.playwright-browsers playwright install chromium"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "vite": "^7.3.0",
    "typescript": "^5.9.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "lucide-react": "^0.562.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.3.0",
    "vitest": "^4.0.16",
    "@playwright/test": "^1.58.1"
  }
}
